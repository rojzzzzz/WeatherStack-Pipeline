ENDPOINT=https://api.weatherstack.com/
API_KEY=replace_with_your_weatherstack_api_key
POSTGRES_ROOT_PASSWORD=replace_with_a_postgres_root_password

# Host paths used by Airflow's DockerOperator. Use absolute paths on the
# machine running Docker, with forward slashes or escaped backslashes.
DBT_PROJECT_HOST_PATH=C:/path/to/Youtube/dbt/dbt/my_project
DBT_PROFILES_HOST_PATH=C:/path/to/Youtube/dbt/dbt

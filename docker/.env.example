PYTHONUNBUFFERED=1
COMPOSE_PROJECT_NAME=superset
DEV_MODE=true

DATABASE_DB=superset_db
DATABASE_HOST=db
DATABASE_PASSWORD=replace_with_a_database_password
DATABASE_USER=superset
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql+psycopg2
POSTGRES_DB=superset_db
POSTGRES_USER=superset
POSTGRES_PASSWORD=replace_with_a_database_password

EXAMPLES_DB=example_db
EXAMPLES_HOST=db
EXAMPLES_USER=examples
EXAMPLES_PASSWORD=replace_with_an_examples_password
EXAMPLES_PORT=5432

PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=redis
REDIS_PORT=6379
FLASK_DEBUG=false
SUPERSET_LOG_LEVEL=info
SUPERSET_APP_ROOT=/
SUPERSET_ENV=production
SUPERSET_ENABLE_SWAGGER_UI=false
SUPERSET_LOAD_EXAMPLES=no
SUPERSET_PORT=8088
MAPBOX_API_KEY=
SUPERSET_SECRET_KEY=replace_with_a_random_secret_key
ADMIN_PASSWORD=replace_with_a_strong_admin_password
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=true
